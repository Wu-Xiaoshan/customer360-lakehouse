# Environment variables read by the pipeline. Not loaded automatically; export them.

# local | iceberg
LAKEHOUSE_MODE=local

# Source CSV directory
LOCAL_DATA=./data

# Parquet output directory, local mode only
LOCAL_OUT=./warehouse

# Iceberg REST catalog and MinIO endpoint
ICEBERG_CATALOG=demo
ICEBERG_REST_URI=http://rest:8181
S3_ENDPOINT=http://minio:9000

# Snapshot reference date; records dated after it are rejected
AS_OF_DATE=2025-12-01

# Days before AS_OF_DATE covered by the behaviour metrics
BEHAVIOUR_WINDOW_DAYS=90

# Tags every metadata row of one run; run_pipeline.sh generates it when unset
RUN_ID=
