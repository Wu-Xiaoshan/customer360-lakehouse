# Environment variables read by the pipeline. Not loaded automatically; export them.

# local | iceberg
LAKEHOUSE_MODE=local

# Source CSV directory
LOCAL_DATA=./data

# Parquet output directory, local mode only
LOCAL_OUT=./warehouse

# Iceberg REST catalog and MinIO endpoint
ICEBERG_CATALOG=demo
ICEBERG_REST_URI=http://rest:8181
S3_ENDPOINT=http://minio:9000

# Written to metadata.ingestion
RUN_ID=run_2025_01
